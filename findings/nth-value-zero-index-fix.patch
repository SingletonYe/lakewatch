From dcaac3e1154f51282f635d3f7ff39ce3ec2f2933 Mon Sep 17 00:00:00 2001
From: Singleton <135771543+SingletonYe@users.noreply.github.com>
Date: Sat, 17 Oct 2026 01:55:23 -0400
Subject: [PATCH] fix: report a zero nth_value index as a user error in the
 aggregate form

`nth_value(x, 0)` (the aggregate form, no OVER) tripped assert_or_internal_err!,
so an ordinary typo was reported as

  Internal error: Assertion failed: n != 0: Nth value indices are 1 based.

together with the "please file a bug report" boilerplate. The index is read from
the literal in NthValue::accumulator, where the ordered and unordered accumulators
are chosen, so validate it once there and return an execution error instead -- the
same way NTILE rejects a non-positive argument. The two assert_or_internal_err!
guards in the accumulators go away; accumulator() is their only caller.

Only the aggregate form is changed. The window form (`nth_value(x, 0) OVER (...)`)
returns NULL for a zero index and window.slt asserts that on purpose, in a section
titled "test handle NULL and 0 value of nth_value", so it is deliberately left
alone; whether the two forms should agree is a maintainer decision.
---
 .../functions-aggregate/src/nth_value.rs      | 24 +++++++++----------
 .../sqllogictest/test_files/aggregate.slt     | 11 +++++++++
 2 files changed, 22 insertions(+), 13 deletions(-)

diff --git a/datafusion/functions-aggregate/src/nth_value.rs b/datafusion/functions-aggregate/src/nth_value.rs
index e3ed110..dbe9857 100644
--- a/datafusion/functions-aggregate/src/nth_value.rs
+++ b/datafusion/functions-aggregate/src/nth_value.rs
@@ -27,9 +27,7 @@ use arrow::array::{ArrayRef, AsArray, StructArray, new_empty_array};
 use arrow::datatypes::{DataType, Field, FieldRef, Fields};
 
 use datafusion_common::utils::{SingleRowListArrayBuilder, get_row_at_idx};
-use datafusion_common::{
-    Result, ScalarValue, assert_or_internal_err, exec_err, not_impl_err,
-};
+use datafusion_common::{Result, ScalarValue, exec_err, not_impl_err};
 use datafusion_expr::DistinctHandling;
 use datafusion_expr::function::{AccumulatorArgs, StateFieldsArgs};
 use datafusion_expr::utils::format_state_name;
@@ -148,6 +146,16 @@ impl AggregateUDFImpl for NthValueAgg {
             }
         };
 
+        // The index is 1-based and negative values count back from the end, so 0 is
+        // never a valid index. Report that as a user error rather than letting the
+        // accumulators trip an internal assertion, which told the user to file a bug
+        // report for their own typo.
+        if n == 0 {
+            return exec_err!(
+                "nth_value index must not be 0; indices are 1-based and negative values count from the end"
+            );
+        }
+
         let Some(ordering) = LexOrdering::new(acc_args.order_bys.to_vec()) else {
             return TrivialNthValueAccumulator::try_new(
                 n,
@@ -213,11 +221,6 @@ impl TrivialNthValueAccumulator {
     /// Create a new order-insensitive NTH_VALUE accumulator based on the given
     /// item data type.
     pub fn try_new(n: i64, datatype: &DataType) -> Result<Self> {
-        // n cannot be 0
-        assert_or_internal_err!(
-            n != 0,
-            "Nth value indices are 1 based. 0 is invalid index"
-        );
         Ok(Self {
             n,
             values: VecDeque::new(),
@@ -344,11 +347,6 @@ impl NthValueAccumulator {
         ordering_dtypes: &[DataType],
         ordering_req: LexOrdering,
     ) -> Result<Self> {
-        // n cannot be 0
-        assert_or_internal_err!(
-            n != 0,
-            "Nth value indices are 1 based. 0 is invalid index"
-        );
         let mut datatypes = vec![datatype.clone()];
         datatypes.extend(ordering_dtypes.iter().cloned());
         Ok(Self {
diff --git a/datafusion/sqllogictest/test_files/aggregate.slt b/datafusion/sqllogictest/test_files/aggregate.slt
index 0665b63..9119b60 100644
--- a/datafusion/sqllogictest/test_files/aggregate.slt
+++ b/datafusion/sqllogictest/test_files/aggregate.slt
@@ -10327,3 +10327,14 @@ DROP TABLE a;
 
 statement ok
 DROP TABLE b;
+
+# nth_value indices are 1-based, so 0 must be reported as an error rather than
+# tripping an internal assertion that asks the user to file a bug report.
+statement ok
+CREATE TABLE nth_value_zero_index (a int) AS VALUES (1), (2);
+
+query error DataFusion error: Execution error: nth_value index must not be 0; indices are 1-based and negative values count from the end
+SELECT nth_value(a, 0) FROM nth_value_zero_index;
+
+statement ok
+DROP TABLE nth_value_zero_index;
